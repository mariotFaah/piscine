#include <unistd.h>

void	ft_is_negative(int n)
{
	char	posi;
	char	nega;
	
	posi = 'P';
	nega = 'N';
	if (n < 0)
	{
		write(1, &nega, 1);
	}
	else	
	{
		write(1, &posi, 1);
	}
}

int	main(void)
{
	ft_is_negative(2);
	ft_is_negative(-2);
	return (0);
}
